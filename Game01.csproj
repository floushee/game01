<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets/Audio/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/Images/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Engine/**/*.cs;Game/**/*.cs;RaylibEngine/**/*.cs" />
    <ProjectReference Include="Game/Game.csproj" />
    <ProjectReference Include="RaylibEngine/RaylibEngine.csproj" />
  </ItemGroup>

</Project>
